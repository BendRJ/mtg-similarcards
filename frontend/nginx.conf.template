server {
    listen 80;
    root /usr/share/nginx/html;
    location /cards {
        proxy_set_header Host $host;
        proxy_pass http://${API_UPSTREAM};
    }
    location /sets {
        proxy_set_header Host $host;
        proxy_pass http://${API_UPSTREAM};
    }
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
    location / { try_files $uri /index.html; }
}
